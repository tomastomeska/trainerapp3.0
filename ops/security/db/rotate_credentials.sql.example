-- Rotate DB credentials for TrainerApp
-- Run as privileged DBA account.
-- Replace ALL placeholders before execution.

-- 1) Create/rotate application DB user password
ALTER USER 'trainerapp_app'@'%' IDENTIFIED BY 'REPLACE_WITH_NEW_STRONG_DB_PASSWORD';

-- Optional safer host scoping (preferred over '%')
-- CREATE USER IF NOT EXISTS 'trainerapp_app'@'127.0.0.1' IDENTIFIED BY 'REPLACE_WITH_NEW_STRONG_DB_PASSWORD';
-- GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, DROP ON `REPLACE_DB_NAME`.* TO 'trainerapp_app'@'127.0.0.1';

-- 2) Ensure only required privileges on application DB
REVOKE ALL PRIVILEGES, GRANT OPTION FROM 'trainerapp_app'@'%';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, DROP
ON `REPLACE_DB_NAME`.* TO 'trainerapp_app'@'%';

-- 3) Disable/remove old DB user used by app (fill old user@host)
-- REVOKE ALL PRIVILEGES, GRANT OPTION FROM 'OLD_APP_USER'@'%';
-- DROP USER 'OLD_APP_USER'@'%';

FLUSH PRIVILEGES;

-- 4) Verify
SHOW GRANTS FOR 'trainerapp_app'@'%';
