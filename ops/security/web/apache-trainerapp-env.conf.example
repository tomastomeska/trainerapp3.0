# Apache vhost env variables for TrainerApp
# Include in the app VirtualHost (:443) or a dedicated conf loaded by Apache.
# Replace placeholders before reload.

# Database
SetEnv TRAINERAPP_DB_HOST "127.0.0.1"
SetEnv TRAINERAPP_DB_NAME "REPLACE_DB_NAME"
SetEnv TRAINERAPP_DB_USER "trainerapp_app"
SetEnv TRAINERAPP_DB_PASS "REPLACE_WITH_NEW_STRONG_DB_PASSWORD"

# App URL/session
SetEnv TRAINERAPP_BASE_URL ""
SetEnv TRAINERAPP_SESSION_NAME "trainerapp_v2_sess"
SetEnv TRAINERAPP_SESSION_SECURE "1"
SetEnv TRAINERAPP_ENABLE_SETUP_ADMIN "0"

# SMTP
SetEnv TRAINERAPP_SMTP_HOST "REPLACE_SMTP_HOST"
SetEnv TRAINERAPP_SMTP_PORT "587"
SetEnv TRAINERAPP_SMTP_USER "REPLACE_SMTP_USER"
SetEnv TRAINERAPP_SMTP_PASS "REPLACE_WITH_NEW_STRONG_SMTP_PASSWORD"
SetEnv TRAINERAPP_SMTP_FROM "REPLACE_SMTP_FROM"
SetEnv TRAINERAPP_SMTP_FROM_NAME "TrainerApp"

# Security switches
SetEnv TRAINERAPP_ENABLE_LIST_PAGE "0"
